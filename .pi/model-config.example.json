{
  "description": "Gallup 技能的模型配置示例",
  "note": "复制此文件到 ~/.pi/agent/models.json 或将其内容合并到现有配置中",
  "workers": {
    "description": "Worker agents 使用的模型配置",
    "model": "zai/glm-4.7",
    "alternatives": {
      "fast": "zai/glm-5-turbo",
      "quality": "zai/glm-4.7"
    }
  },
  "synthesizer": {
    "description": "Synthesizer agent 使用的模型配置",
    "model": "zai/glm-4.7",
    "alternatives": {
      "fast": "zai/glm-5-turbo",
      "quality": "zai/glm-4.7"
    }
  },
  "providers": {
    "zai": {
      "baseUrl": "https://open.bigmodel.cn/api/coding/paas/v4",
      "api": "openai-completions",
      "apiKey": "ZAI_API_KEY",
      "models": [
        {
          "id": "glm-4.7",
          "name": "GLM-4.7",
          "description": "智谱 GLM-4.7 模型"
        },
        {
          "id": "glm-5-turbo",
          "name": "GLM-5-Turbo",
          "description": "智谱 GLM-5 Turbo 模型"
        }
      ]
    },
    "custom-openai": {
      "description": "自定义 OpenAI 格式 API 示例",
      "baseUrl": "https://your-api-endpoint.com/v1",
      "api": "openai-completions",
      "apiKey": "YOUR_API_KEY",
      "models": [
        {
          "id": "gpt-4",
          "name": "GPT-4"
        },
        {
          "id": "gpt-3.5-turbo",
          "name": "GPT-3.5 Turbo"
        }
      ]
    }
  }
}
